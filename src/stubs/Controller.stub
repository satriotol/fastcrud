    public function destroy($uuid)
    {
        try {
            DB::beginTransaction();
            $this->{{modelNameSingular}}Repository->delete($uuid);
            DB::commit();
            return back()->with('success', '{{indonesian_name}} Berhasil Dihapus');
        } catch (FastcrudException $fe) {
            DB::rollBack();
            return back()->with('error', $fe->getMessage());
        } catch (\Throwable $th) {
            DB::rollBack();
