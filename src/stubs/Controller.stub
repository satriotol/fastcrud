        $data = $request->validate($validation['rules'], $validation['messages']);
        try {
            DB::beginTransaction();
            $this->{{modelNameSingular}}Repository->update($uuid, $data);
            DB::commit();
            return redirect(route('{{modelNameSingular}}.index'))->with('success', '{{indonesian_name}} Berhasil Terupdate');
        } catch (FastcrudException $fe) {
            DB::rollBack();
            return back()->with('error', $fe->getMessage())->withInput();
        } catch (\Throwable $th) {
            DB::rollBack();
            Log::error('Terjadi kesalahan ketika mengupdate {{indonesian_name}}: ' . $th->getMessage(), [
                'exception' => $th,
            ]);
            return back()->with('error', 'Terjadi kesalahan saat mengupdate {{indonesian_name}}. Silakan coba lagi.')->withInput();
