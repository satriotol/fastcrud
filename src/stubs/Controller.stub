    public function index(Request $request)
    {
        ${{modelNamePlural}} = $this->{{modelNameSingular}}Repository->getAll(
            [
            ], $request
        )->orderBy('id','desc')->paginate();
        $request->flash();
        return view('backend.{{modelNameSingular}}.index', compact('{{modelNamePlural}}'));
    }

    public function create()
    {
        return view('backend.{{modelNameSingular}}.create');
    }

    public function store(Request $request)
    {
        $validation = $this->{{modelNameSingular}}Repository->validate();
        $data = $request->validate($validation['rules'], $validation['messages']);
        try {
            DB::beginTransaction();
            $this->{{modelNameSingular}}Repository->create($data);
            DB::commit();
            return redirect(route('{{modelNameSingular}}.index'))->with('success', '{{indonesian_name}} Berhasil Tersimpan');
        } catch (FastcrudException $fe) {
            DB::rollBack();
            return back()->with('error', $fe->getMessage())->withInput();
        } catch (\Throwable $th) {
            DB::rollBack();
            Log::error('Terjadi kesalahan ketika menyimpan {{indonesian_name}}: ' . $th->getMessage(), [
                'exception' => $th,
            ]);
            return back()->with('error', 'Terjadi kesalahan saat menyimpan {{indonesian_name}}. Silakan coba lagi.')->withInput();
        }
    }

    public function show($uuid)
    {
        ${{modelNameSingular}} = $this->{{modelNameSingular}}Repository->findByUuid($uuid);
        return view('backend.{{modelNameSingular}}.create', compact('{{modelNameSingular}}'));
    }

    public function edit($uuid)
    {
        ${{modelNameSingular}} = $this->{{modelNameSingular}}Repository->findByUuid($uuid);
        return view('backend.{{modelNameSingular}}.create', compact('{{modelNameSingular}}'));
    }

    public function update(Request $request, $uuid)
    {
